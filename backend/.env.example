# ──────────────────────────────────────────────────────────────
# SportsHub Social — Variáveis de Ambiente
# Copia este ficheiro para .env e preenche os valores reais.
# NUNCA faças commit do ficheiro .env para o repositório!
# ──────────────────────────────────────────────────────────────

# Azure Cosmos DB
# Obtém em: Portal Azure → Cosmos DB → Keys → PRIMARY CONNECTION STRING
COSMOS_CONNECTION_STRING="AccountEndpoint=https://sportshub-cosmos.documents.azure.com:443/;AccountKey=SUA_CHAVE_AQUI;"
COSMOS_DATABASE="sportshub"

# Azure Blob Storage
# Obtém em: Portal Azure → Storage Account → Access keys → Connection string
BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=sportshubstorage;AccountKey=SUA_CHAVE_AQUI;EndpointSuffix=core.windows.net"
BLOB_ACCOUNT_URL="https://sportshubstorage.blob.core.windows.net"

# JWT (usa um valor longo e aleatório — mínimo 32 caracteres)
JWT_SECRET="altera-isto-para-uma-chave-secreta-muito-longa-e-aleatoria"

# Azure Functions endpoint
FUNCTIONS_ENDPOINT="https://sportshub-functions.azurewebsites.net"

# Frontend URL (para CORS)
FRONTEND_URL="http://localhost:5173"

# Servidor
PORT=3000
NODE_ENV=development
